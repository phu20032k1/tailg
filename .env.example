# Preferred server-side Supabase variables
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_YOUR_SERVER_SECRET_KEY
SUPABASE_STORAGE_BUCKET=site-photos

# Recommended but optional: when omitted, TAILG derives the session signing key
# from SUPABASE_SECRET_KEY / SUPABASE_SERVICE_ROLE_KEY on the server.
# SESSION_SECRET=GENERATE_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS

# Supported fallbacks used by some Supabase/Vercel integrations:
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=YOUR_LEGACY_SERVICE_ROLE_KEY
